{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtime", "publication", "validation", "ci"],
  "properties": {
    "version": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract"],
      "properties": { "contract": { "const": 1 } }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "label", "auto_on_open_for_trusted"],
      "properties": {
        "mode": { "const": "human_pr_mention" },
        "label": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,49}$" },
        "auto_on_open_for_trusted": { "type": "boolean" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "branch_prefix"],
      "properties": {
        "mode": { "const": "codex_cloud_direct" },
        "branch_prefix": { "const": "agent/issue-" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "fallback"],
      "properties": {
        "source": { "enum": ["codeowners", "config"] },
        "fallback": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commands"],
      "properties": {
        "commands": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "trigger", "workflow", "app_slug", "required_checks", "timeout_seconds"],
      "properties": {
        "required": { "const": true },
        "trigger": { "enum": ["pull_request", "workflow_dispatch"] },
        "workflow": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*\\.ya?ml$" },
        "app_slug": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,99}$" },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "timeout_seconds": { "type": "integer", "minimum": 30, "maximum": 3000 }
      }
    },
    "protected_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["additional"],
      "properties": {
        "additional": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
